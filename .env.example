# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values marked with <your-value>.
# Never commit your .env file to version control.
#
# QUICK START:
#   1. cp .env.example .env
#   2. Fill in MODEM_IP, MODEM_USERNAME, MODEM_PASSWORD, and CENTCON_PIN
#   3. All other values have sensible defaults and can be left as-is
# =============================================================================


# =============================================================================
# MODEM CONNECTION
# =============================================================================
# The local IP address of your modem (e.g. 192.168.0.1 or 192.168.100.1).
# Check your router/modem label or run: ip route | grep default
MODEM_IP=<your-modem-ip>

# Full URL constructed from MODEM_IP
# a non-standard path or port (e.g. http://192.168.0.1/)
# Set the full URL explicitly. (e.g. MODEM_URL=http://192.168.0.1/)
MODEM_URL=http://<your-modem-ip>/

# Credentials for logging into the modem admin panel.
# These are the username/password you use on the modem's web interface.
MODEM_USERNAME=<your-modem-username>
MODEM_PASSWORD=<your-modem-password>


# =============================================================================
# FRONTEND (Vite)
# =============================================================================
# Modem IP exposed to the frontend for display or direct requests.
# Usually the same value as MODEM_IP above.
VITE_MODEM_IP=<your-modem-ip>

# How often the frontend automatically refreshes data, in milliseconds.
# Default: 60000 (every 60 seconds).
VITE_AUTO_REFRESH_INTERVAL=60000

# The backend API base URL that the frontend will send reboot requests to.
# Change this if your backend runs on a different host or port.
VITE_REBOOT_API_URL=http://localhost:8000


# =============================================================================
# BACKEND SERVER
# =============================================================================
# Network interface the backend listens on.
# 0.0.0.0 = all interfaces (accessible on your LAN).
# 127.0.0.1 = localhost only (more restrictive, recommended if not needed on LAN).
API_HOST=0.0.0.0

# Port the backend API server listens on.
# Must match the port in VITE_REBOOT_API_URL above.
API_PORT=8000


# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of origins allowed to make requests to the backend.
# Add your frontend's origin here if it differs from the defaults.
# Example for production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000


# =============================================================================
# AUTHENTICATION (Centcon)
# =============================================================================
# PIN required to access the application.
# Must be exactly 4 characters (numbers or letters) — do not leave this blank.
CENTCON_PIN=<your-4-char-pin>


# Whether to show the login page on startup.
# true  = show login page and require PIN
# false = skip login entirely (only use in trusted local environments)
CENTCON_SHOW_LOGIN=true


# =============================================================================
# SELENIUM / BROWSER AUTOMATION
# =============================================================================
# Whether Selenium runs the browser in headless mode (no visible window).
# true  = headless, recommended for servers and production use
# false = shows the browser window, useful for debugging automation issues
REBOOT_SELENIUM_HEADLESS=true


