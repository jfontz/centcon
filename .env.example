# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# This file documents all available environment variables and their defaults.
# Never commit your actual .env file to version control.
#
# QUICK START:
#   On first run, CENTCON will automatically launch a setup wizard in your
#   browser. The wizard will guide you through the required values and
#   generate the .env file for you — you do not need to edit this file manually.
#
# MANUAL SETUP (optional):
#   If you prefer to configure manually, copy this file to .env and fill in
#   the values marked with <your-value>. Only the fields in the MODEM
#   CONNECTION and AUTHENTICATION sections are required. Everything else has
#   sensible defaults.
# =============================================================================


# =============================================================================
# MODEM CONNECTION
# =============================================================================
# The local IP address of your modem's admin page — not your public internet IP.
# For Globe G-1426G-A this is typically 192.168.254.254.
# Check the sticker on the back of your modem, or run:
#   Windows: ipconfig  (look for "Default Gateway")
#   Mac/Linux: ip route  (look for "default via")
MODEM_IP=<your-modem-ip>

# Full URL to the modem admin page, constructed from MODEM_IP.
# This is set automatically by the setup wizard based on MODEM_IP.
MODEM_URL=http://<your-modem-ip>/

# Login credentials for your modem's admin panel.
# These are the same username and password you use to log into your modem's
# web interface — usually printed on the sticker on your modem.
MODEM_USERNAME=<your-modem-username>
MODEM_PASSWORD=<your-modem-password>


# =============================================================================
# FRONTEND (Vite)
# =============================================================================
# Modem IP exposed to the frontend. Set automatically to match MODEM_IP.
VITE_MODEM_IP=<your-modem-ip>

# How often the frontend automatically refreshes modem data, in milliseconds.
# Default: 60000 (every 60 seconds)
VITE_AUTO_REFRESH_INTERVAL=60000

# The base URL of the backend API. Change this only if your backend runs
# on a different host or port.
VITE_BACKEND_URL=http://localhost:8000


# =============================================================================
# BACKEND SERVER
# =============================================================================
# Network interface the backend listens on.
# 0.0.0.0 = listens on all network interfaces, any device on your local network can reach the backend
#           useful for multi-device access, but dangerous without proper authentication on command endpoints
# 127.0.0.1 = listens on your own machine only, not reachable from other devices (default, recommended)
API_HOST=127.0.0.1

# Port the backend API server listens on.
# Must match the port used in VITE_BACKEND_URL.
API_PORT=8000


# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of frontend origins allowed to make requests to the backend.
# The defaults cover standard local development ports.
# Add additional origins here if you run the frontend on a different port or host.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000


# =============================================================================
# AUTHENTICATION
# =============================================================================
# A 4-character PIN (letters and/or numbers) used to access the CENTCON dashboard.
# This is a PIN you choose — it is not your modem's password.
# If you forget it, this file is the source of truth — just look it up here
# and restart the app.
CENTCON_PIN=<your-4-char-pin>

# Whether to show the login screen on startup.
# true  = require PIN on every open (recommended)
# false = skip login entirely (only use in trusted local environments)
CENTCON_SHOW_LOGIN=true


# =============================================================================
# SELENIUM / BROWSER AUTOMATION
# =============================================================================
# Whether Selenium runs in headless mode (no visible browser window).
# true  = headless, no window shown (default, recommended)
# false = shows the browser window, useful for debugging automation issues
REBOOT_SELENIUM_HEADLESS=true

# Whether the Wi-Fi credentials automation runs headless.
# true  = headless, no window shown (default, recommended)
# false = shows the browser window, useful for debugging automation issues
WIFI_SELENIUM_HEADLESS=true
